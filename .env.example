# ── RAG application ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=eu_ai_act
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base
EU_AI_ACT_PDF=./data/eu_ai_act.pdf

# Required bearer to call /query and /ingest. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Compared via hmac.compare_digest server-side.
RAG_API_TOKEN=replace-me

# Optional demo profile that disables RAG_API_TOKEN. Never set in
# production; the loud warning in api.py is the only safety net.
# AURACOMPLY_DEMO_PROFILE=0

# ── AuraComply kernel SDK (sealing path) ─────────────────────────────
# URL of the kernel's HTTP API. The SDK posts to /audit/log etc.
AURACOMPLY_URL=http://localhost:5002
# Bearer token issued by the kernel for THIS tenant. Tenant identity
# is derived server-side from this token — never put it in a body.
AURACOMPLY_API_TOKEN=replace-with-kernel-token
# HMAC key for the SDK's signed buffer (required in buffered/strict).
# 32 bytes hex; generate with
# `python -c "import secrets; print(secrets.token_hex(32))"`.
AURACOMPLY_BUFFER_HMAC_KEY=replace-with-hex-key
AURACOMPLY_BUFFER_DIR=./.auracomply-buffer
# buffered (default), strict, warn. See sdk/auracomply/policy.py.
AURACOMPLY_SEAL_POLICY=buffered
